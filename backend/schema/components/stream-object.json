{
	"type": "object",
	"description": "Stream object",
	"required": [
		"id",
		"created_on",
		"modified_on",
		"owner_user_id",
		"incoming_port",
		"forwarding_host",
		"forwarding_port",
		"tcp_forwarding",
		"udp_forwarding",
		"enabled",
		"meta"
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"owner_user_id": {
			"$ref": "../common.json#/properties/user_id"
		},
		"incoming_port": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535,
			"example": 9090
		},
		"incoming_ports": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"type": "integer",
				"minimum": 1,
				"maximum": 65535
			},
			"example": [9090, 9091]
		},
		"forwarding_host": {
			"anyOf": [
				{
					"description": "Hostname",
					"type": "string",
					"format": "hostname",
					"example": "example.com"
				},
				{
					"description": "IPv4 address",
					"type": "string",
					"format": "ipv4",
					"example": "127.0.0.1"
				},
				{
					"description": "IPv6 address",
					"type": "string",
					"format": "ipv6",
					"example": "2001:db8::1"
				}
			],
			"example": "example.com"
		},
		"forwarding_port": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535,
			"example": 80
		},
		"forwarding_ports": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"type": "integer",
				"minimum": 1,
				"maximum": 65535
			},
			"example": [80, 81]
		},
		"upstream_enabled": {
			"type": "boolean",
			"example": false
		},
		"upstream_policy": {
			"type": "string",
			"enum": ["round_robin", "least_conn", "ip_hash"],
			"example": "round_robin"
		},
		"upstream_servers": {
			"$ref": "./proxy-host-object.json#/properties/upstream_servers"
		},
		"tcp_forwarding": {
			"type": "boolean",
			"example": true
		},
		"udp_forwarding": {
			"type": "boolean",
			"example": false
		},
		"proxy_protocol": {
			"type": "boolean",
			"example": false
		},
		"proxy_protocol_upstream": {
			"type": "boolean",
			"example": false
		},
		"geo_access_override": {
			"type": "boolean",
			"example": false
		},
		"geo_access_enabled": {
			"type": "boolean",
			"example": false
		},
		"geo_access_mode": {
			"type": "string",
			"enum": ["allow", "deny"],
			"example": "allow"
		},
		"geo_access_preset": {
			"type": "string",
			"example": "europe-allow"
		},
		"geo_access_countries": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 2,
				"maxLength": 2
			},
			"example": ["DE", "AT"]
		},
		"enabled": {
			"$ref": "../common.json#/properties/enabled"
		},
		"certificate_id": {
			"$ref": "../common.json#/properties/certificate_id"
		},
		"meta": {
			"type": "object",
			"example": {}
		},
		"certificate": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"$ref": "./certificate-object.json"
				}
			],
			"example": null
		},
		"owner": {
			"$ref": "./user-object.json"
		}
	}
}
