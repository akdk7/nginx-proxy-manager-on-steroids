{
	"operationId": "checkProxyHostHeartbeat",
	"summary": "Check Proxy Host heartbeat",
	"tags": ["proxy-hosts"],
	"security": [
		{
			"bearerAuth": ["proxy_hosts.view"]
		}
	],
	"requestBody": {
		"description": "Heartbeat Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": ["hosts"],
					"properties": {
						"hosts": {
							"type": "array",
							"minItems": 1,
							"maxItems": 50,
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": ["forward_scheme", "forward_host", "forward_port"],
								"properties": {
									"id": {
										"$ref": "../../../../common.json#/properties/id"
									},
									"forward_scheme": {
										"$ref": "../../../../components/proxy-host-object.json#/properties/forward_scheme"
									},
									"forward_host": {
										"$ref": "../../../../components/proxy-host-object.json#/properties/forward_host"
									},
									"forward_port": {
										"$ref": "../../../../components/proxy-host-object.json#/properties/forward_port"
									}
								}
							}
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 1,
									"ok": true,
									"status_code": 200,
									"status": "ok",
									"latency_ms": 32,
									"checked_at": "2026-01-01T12:00:00.000Z"
								},
								{
									"id": 2,
									"ok": false,
									"error": "connect ECONNREFUSED 127.0.0.1:3000",
									"status": "failed",
									"latency_ms": 12,
									"checked_at": "2026-01-01T12:00:01.000Z"
								}
							]
						}
					}
				}
			}
		}
	}
}
