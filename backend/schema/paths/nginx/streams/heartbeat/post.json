{
	"operationId": "checkStreamHeartbeat",
	"summary": "Check Stream heartbeat",
	"tags": ["streams"],
	"security": [
		{
			"bearerAuth": ["streams.view"]
		}
	],
	"requestBody": {
		"description": "Heartbeat Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": ["streams"],
					"properties": {
						"streams": {
							"type": "array",
							"minItems": 1,
							"maxItems": 50,
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": ["forwarding_host", "forwarding_port", "tcp_forwarding", "udp_forwarding"],
								"properties": {
									"id": {
										"$ref": "../../../../common.json#/properties/id"
									},
									"forwarding_host": {
										"type": "string",
										"minLength": 1,
										"maxLength": 255
									},
									"forwarding_port": {
										"type": "integer",
										"minimum": 1,
										"maximum": 65535
									},
									"tcp_forwarding": {
										"type": "boolean"
									},
									"udp_forwarding": {
										"type": "boolean"
									}
								}
							}
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": 1,
									"ok": true,
									"latency_ms": 22,
									"checked_at": "2026-01-01T12:00:00.000Z",
									"status": "ok"
								},
								{
									"id": 2,
									"ok": false,
									"error": "UDP heartbeat not supported",
									"checked_at": "2026-01-01T12:00:01.000Z",
									"status": "unsupported"
								}
							]
						}
					}
				}
			}
		}
	}
}
