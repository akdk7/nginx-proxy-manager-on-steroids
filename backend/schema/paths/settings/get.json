{
	"operationId": "getSettings",
	"summary": "Get all settings",
	"tags": ["settings"],
	"security": [
		{
			"bearerAuth": ["admin"]
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"id": "default-site",
									"name": "Default Site",
									"description": "What to show when Nginx is hit with an unknown Host",
									"value": "congratulations",
									"meta": {}
								},
								{
									"id": "proxy-protocol",
									"name": "PROXY Protocol",
									"description": "Ports that should expect the PROXY protocol header",
									"value": "ports",
									"meta": {
										"ports": []
									}
								},
								{
									"id": "geo-access",
									"name": "Geo Access Control",
									"description": "GeoIP2-based access control for proxy hosts and streams",
									"value": "geo-access",
									"meta": {
										"http_enabled": false,
										"stream_enabled": false,
										"db_path": "/data/GeoLite2-Country.mmdb",
										"mode": "allow",
										"countries": [],
										"presets": []
									}
								}
							]
						}
					},
					"schema": {
						"$ref": "../../components/setting-list.json"
					}
				}
			}
		}
	}
}
